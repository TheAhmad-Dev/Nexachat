# ============================================================
# Nexachat frontend environment (template)
#
# Copy this file to .env.local and adjust if needed.
#
# RECOMMENDED: leave EXPO_PUBLIC_API_URL empty. The app then
# discovers your development PC's LAN IP automatically at
# runtime from the Expo/Metro connection — no IP editing when
# your WiFi or DHCP lease changes.
#
# Only set it to pin a specific backend, e.g. a deployed API:
#   EXPO_PUBLIC_API_URL=https://api.yourdomain.com
# ============================================================

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=3000
