{
  "expo": {
    "name": "Nexachat",
    "slug": "Nexachat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Applogo.png",
    "scheme": "nexachat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/Applogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ahmad7.Nexachat",
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },    "plugins": [
      "expo-router", 
      [
        "expo-splash-screen", 
        {
          "image": "./assets/images/SplashScreenLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13088422-86d5-48d6-b421-ef3cb3958f90"
      }
    }
  }
}
